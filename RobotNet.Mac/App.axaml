<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RobotNet.Windows.Wpf.ViewModels"
             xmlns:views="using:RobotNet.Mac.Views"
             x:Class="RobotNet.Mac.App" RequestedThemeVariant="Light">
    <Application.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#EEF3F8" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#F7FAFC" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#D9E2EC" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#18212C" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5B6673" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2563A6" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#1F5793" />
        <SolidColorBrush x:Key="SidebarBrush" Color="#182330" />
        <SolidColorBrush x:Key="SidebarHoverBrush" Color="#263646" />
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
        <Style Selector="TextBlock.pageTitle">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.pageSubtitle">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>
        <Style Selector="TextBlock.value">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Application.Styles>
    <Application.DataTemplates>
        <DataTemplate DataType="vm:DashboardViewModel"><views:DashboardView /></DataTemplate>
        <DataTemplate DataType="vm:TutorialViewModel"><views:TutorialView /></DataTemplate>
        <DataTemplate DataType="vm:EasyModeViewModel"><views:EasyModeView /></DataTemplate>
        <DataTemplate DataType="vm:AdaptersViewModel"><views:AdaptersView /></DataTemplate>
        <DataTemplate DataType="vm:DiscoveryViewModel"><views:DiscoveryView /></DataTemplate>
        <DataTemplate DataType="vm:SessionViewModel"><views:SessionView /></DataTemplate>
        <DataTemplate DataType="vm:TcpProxyViewModel"><views:TcpProxyView /></DataTemplate>
        <DataTemplate DataType="vm:VirtualSubnetViewModel"><views:VirtualSubnetView /></DataTemplate>
        <DataTemplate DataType="vm:ProductionViewModel"><views:ProductionView /></DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel"><views:SettingsView /></DataTemplate>
        <DataTemplate DataType="vm:DiagnosticsViewModel"><views:DiagnosticsView /></DataTemplate>
        <DataTemplate DataType="vm:LogsViewModel"><views:LogsView /></DataTemplate>
    </Application.DataTemplates>
</Application>
