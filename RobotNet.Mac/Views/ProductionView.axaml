<UserControl x:Class="RobotNet.Mac.Views.ProductionView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="发布与更新 Release"
                           Classes="pageTitle" />
                <TextBlock Text="第六阶段：GitHub Releases 更新、发布包下载、崩溃报告、持久化日志和发布检查。"
                           Classes="pageSubtitle" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        Margin="16,6,0,0">
                <Button Width="110"
                        Height="36"
                        Margin="0,0,10,0"
                        Command="{Binding CheckUpdatesCommand}"
                        Content="检查更新" />
                <Button Width="110"
                        Height="36"
                        Margin="0,0,10,0"
                        Command="{Binding DownloadUpdateCommand}"
                        Content="下载更新" />
                <Button Width="130"
                        Height="36"
                        Command="{Binding OpenReleasePageCommand}"
                        Content="打开 Releases" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1"
                Margin="0,24,0,0"
                Background="White"
                BorderBrush="#DDE3EA"
                BorderThickness="1"
                CornerRadius="8"
                Padding="22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="当前版本" Classes="label" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CurrentVersion}" Classes="value" />

                <TextBlock Grid.Row="0" Grid.Column="2" Text="GitHub 仓库" Classes="label" />
                <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding RepositoryText}" Classes="value" />

                <TextBlock Grid.Row="1" Text="更新状态" Classes="label" />
                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Grid.ColumnSpan="3"
                           Text="{Binding UpdateStatus}"
                           TextWrapping="Wrap"
                           Classes="value" />

                <TextBlock Grid.Row="2" Text="下载状态" Classes="label" />
                <TextBlock Grid.Row="2"
                           Grid.Column="1"
                           Grid.ColumnSpan="3"
                           Text="{Binding DownloadStatus}"
                           TextWrapping="Wrap"
                           Classes="value" />

                <TextBlock Grid.Row="3" Text="下载路径" Classes="label" />
                <TextBlock Grid.Row="3"
                           Grid.Column="1"
                           Grid.ColumnSpan="3"
                           Text="{Binding DownloadPath}"
                           TextWrapping="Wrap"
                           FontFamily="Consolas"
                           Classes="value" />

                <StackPanel Grid.Row="4"
                            Grid.ColumnSpan="4"
                            Orientation="Horizontal"
                            Margin="0,8,0,0">
                    <Button Width="110"
                            Height="34"
                            Margin="0,0,10,0"
                            Command="{Binding OpenLogsFolderCommand}"
                            Content="日志目录" />
                    <Button Width="110"
                            Height="34"
                            Margin="0,0,10,0"
                            Command="{Binding OpenCrashFolderCommand}"
                            Content="崩溃目录" />
                    <Button Width="110"
                            Height="34"
                            Command="{Binding OpenUpdatesFolderCommand}"
                            Content="更新目录" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="White"
                    BorderBrush="#DDE3EA"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="1"
                    Margin="0,0,18,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="发布检查项"
                               Margin="18,16,18,8"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <DataGrid IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" CanUserResizeColumns="True" ItemsSource="{Binding Checklist}">
                <DataGrid.Columns>
                                <DataGridTextColumn Header="项目" Width="130" Binding="{Binding Name}" />
                                <DataGridTemplateColumn Header="状态" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Status}"
                                                       Foreground="{Binding StatusColor}"
                                                       FontWeight="SemiBold" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="说明" Width="210" Binding="{Binding Detail}" />
                </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="White"
                    BorderBrush="#DDE3EA"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="GitHub Release 资源"
                               Margin="18,16,18,8"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <DataGrid IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" CanUserResizeColumns="True" ItemsSource="{Binding Assets}">
                <DataGrid.Columns>
                                <DataGridTextColumn Header="文件" Width="360" Binding="{Binding Name}" />
                                <DataGridTextColumn Header="大小" Width="90" Binding="{Binding SizeText}" />
                                <DataGridTextColumn Header="类型" Width="180" Binding="{Binding ContentType}" />
                                <DataGridTextColumn Header="下载地址" Width="520" Binding="{Binding DownloadUrl}" />
                </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
