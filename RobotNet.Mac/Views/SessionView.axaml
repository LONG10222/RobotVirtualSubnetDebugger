<UserControl x:Class="RobotNet.Mac.Views.SessionView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="连接会话 Session"
                           Classes="pageTitle" />
                <TextBlock Text="第二阶段：模拟隧道握手和会话状态，不创建真实虚拟网卡，不修改路由，不转发真实流量。"
                           Classes="pageSubtitle" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        Margin="16,6,0,0">
                <Button Width="120"
                        Height="36"
                        Margin="0,0,10,0"
                        Command="{Binding StartCommand}"
                        Content="启动模拟会话" />
                <Button Width="100"
                        Height="36"
                        Command="{Binding StopCommand}"
                        Content="停止会话" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1"
                Margin="0,24,0,0"
                Background="White"
                BorderBrush="#DDE3EA"
                BorderThickness="1"
                CornerRadius="8"
                Padding="22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="状态" Classes="label" />
                <TextBlock Grid.Row="0"
                           Grid.Column="1"
                           Text="{Binding StatusText}"
                           Foreground="{Binding StatusColor}"
                           Classes="value" />

                <TextBlock Grid.Row="0" Grid.Column="2" Text="会话 ID" Classes="label" />
                <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding SessionId}" Classes="value" />

                <TextBlock Grid.Row="1" Text="本机角色" Classes="label" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RoleText}" Classes="value" />

                <TextBlock Grid.Row="1" Grid.Column="2" Text="网关端 LAN IP" Classes="label" />
                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding GatewayLanIp}" Classes="value" />

                <TextBlock Grid.Row="2" Text="目标设备 IP" Classes="label" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TargetDeviceIp}" Classes="value" />

                <TextBlock Grid.Row="2" Grid.Column="2" Text="虚拟 IP" Classes="label" />
                <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding VirtualIp}" Classes="value" />

                <TextBlock Grid.Row="3" Text="已连接对端" Classes="label" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PeerDeviceName}" Classes="value" />

                <TextBlock Grid.Row="3"
                           Grid.Column="2"
                           Text="对端 LAN IP"
                           Classes="label" />
                <TextBlock Grid.Row="3"
                           Grid.Column="3"
                           Text="{Binding PeerLanIp}"
                           Classes="value" />

                <TextBlock Grid.Row="4" Text="最后更新" Classes="label" />
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding LastUpdatedText}" Classes="value" />

                <TextBlock Grid.Row="4"
                           Grid.Column="2"
                           Text="说明"
                           Classes="label" />
                <TextBlock Grid.Row="4"
                           Grid.Column="3"
                           Grid.ColumnSpan="2"
                           Text="{Binding Message}"
                           TextWrapping="Wrap"
                           Classes="value" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Margin="0,18,0,0"
                Background="White"
                BorderBrush="#DDE3EA"
                BorderThickness="1"
                CornerRadius="8"
                Padding="1">
            <DataGrid IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" CanUserResizeColumns="True" ItemsSource="{Binding Steps}"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                        <DataGridTextColumn Header="时间" Width="90" Binding="{Binding TimestampText}" />
                        <DataGridTextColumn Header="步骤" Width="160" Binding="{Binding Name}" />
                        <DataGridTemplateColumn Header="状态" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StatusText}"
                                               Foreground="{Binding StatusColor}"
                                               FontWeight="SemiBold" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="说明" Width="560" Binding="{Binding Message}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
