<UserControl x:Class="RobotNet.Windows.Wpf.Views.EasyModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="连接向导 · 先 A 后 B"
                       Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="先在 A 电脑配置，再在 B 电脑连接。两台电脑需网络互通；首次只验证连接和状态，不运行机械臂运动代码。"
                       Style="{StaticResource PageSubtitleStyle}" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,22,0,0"
                Background="White"
                BorderBrush="#DDE3EA"
                BorderThickness="1"
                CornerRadius="8"
                Padding="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Height="44"
                        Margin="0,0,10,0"
                        Command="{Binding SelectGatewayRoleCommand}"
                        Content="第 1 步：我是 A · 连接机械臂" />
                <Button Grid.Column="1"
                        Height="44"
                        Margin="10,0,0,0"
                        Command="{Binding SelectClientRoleCommand}"
                        Content="第 1 步：我是 B · 运行代码" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <Border Background="White"
                    BorderBrush="#DDE3EA"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,18,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="第 2 步：核对参数"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding RoleText}"
                                   Margin="0,8,0,16"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />

                        <TextBlock Text="机械臂原 IP（代码中填写的地址）" Style="{StaticResource DashboardLabelStyle}" />
                        <TextBox Height="32"
                                 Margin="0,0,0,12"
                                 Text="{Binding TargetDeviceIp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="主连接端口（不代表 SDK 的全部端口）" Style="{StaticResource DashboardLabelStyle}" />
                        <TextBox Height="32"
                                 Margin="0,0,0,12"
                                 Text="{Binding TargetDevicePort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="共享密钥（可信渠道复制）" Style="{StaticResource DashboardLabelStyle}" />
                        <TextBox Height="32"
                                 Margin="0,0,0,8"
                                 IsReadOnly="{Binding IsGatewayRole}"
                                 AutomationProperties.Name="共享密钥，B 电脑粘贴 A 电脑提供的密钥"
                                 Text="{Binding SharedKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Height="34"
                                Margin="0,0,0,12"
                                Command="{Binding GenerateSharedKeyCommand}"
                                Content="生成新密钥（两端需重新配对）"
                                Visibility="{Binding IsGatewayRole, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <StackPanel Visibility="{Binding IsGatewayRole, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="A 的有线网口 IP（不能与机械臂相同）" Style="{StaticResource DashboardLabelStyle}" />
                            <TextBox Height="32"
                                     Margin="0,0,0,12"
                                     Text="{Binding TargetDeviceAdapterIp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <TextBlock Text="法奥示例：机械臂 192.168.57.2；SDK 使用 20003 / 20004 / 8080。原 IP 模式不要开启单端口代理，先在高级设置核对模式。" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12" />
                        <TextBlock Text="子网掩码" Style="{StaticResource DashboardLabelStyle}" />
                        <TextBox Height="32"
                                 Margin="0,0,0,12"
                                 Text="{Binding VirtualSubnetMask, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <StackPanel Visibility="{Binding IsClientRole, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="本地监听端口（仅单端口代理使用）" Style="{StaticResource DashboardLabelStyle}" />
                            <TextBox Height="32"
                                     Margin="0,0,0,12"
                                     Text="{Binding LocalListenPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <TextBlock Text="A 的局域网 IP（两台电脑互通的地址）" Style="{StaticResource DashboardLabelStyle}" />
                        <TextBox Height="32"
                                 Margin="0,0,0,12"
                                 Text="{Binding GatewayLanIp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <StackPanel Visibility="{Binding IsClientRole, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="发现到的主机 A" Style="{StaticResource DashboardLabelStyle}" />
                            <ComboBox Height="32"
                                      Margin="0,0,0,14"
                                      ItemsSource="{Binding Gateways}"
                                      SelectedItem="{Binding SelectedGateway, Mode=TwoWay}"
                                      DisplayMemberPath="ComputerName" />

                            <Button Height="36"
                                    Margin="0,4,0,10"
                                    Command="{Binding RefreshGatewaysCommand}"
                                    Content="刷新主机 A" />
                        </StackPanel>
                        <TextBlock Margin="0,2,0,12"
                                   Text="主机 A 不主动搜索其他电脑；配置完成后只广播自身并等待主机 B 连接。"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Visibility="{Binding IsGatewayRole, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <Button Height="36"
                                Margin="0,0,0,10"
                                Command="{Binding PreviewCommand}"
                                Content="第 3 步：预览操作（不修改网络）" />
                        <Button Height="38"
                                Margin="0,0,0,10"
                                Command="{Binding ApplyGatewayCommand}"
                                Content="第 4 步：确认并配置 A（修改网络）"
                                Visibility="{Binding IsGatewayRole, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <Button Height="38"
                                Margin="0,0,0,10"
                                Command="{Binding ApplyClientCommand}"
                                Content="第 4 步：确认并连接 A（修改网络）"
                                Visibility="{Binding IsClientRole, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <Button Height="36"
                                Command="{Binding RollbackCommand}"
                                Content="撤销本程序上次网络修改" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="160" />
                </Grid.RowDefinitions>

                <Border Background="White"
                        BorderBrush="#DDE3EA"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18">
                    <StackPanel>
                        <TextBlock Text="{Binding ApplyStatusText}" TextWrapping="Wrap"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding Status}"
                                   Margin="0,8,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding PlanSummary}"
                                   Margin="0,8,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1"
                        Margin="0,18,0,0"
                        Background="White"
                        BorderBrush="#DDE3EA"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="1">
                    <ListView ItemsSource="{Binding PreviewSteps}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="#" Width="42" DisplayMemberBinding="{Binding Order}" />
                                <GridViewColumn Header="操作" Width="160" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="风险" Width="70" DisplayMemberBinding="{Binding RiskLevel}" />
                                <GridViewColumn Header="说明" Width="320" DisplayMemberBinding="{Binding Description}" />
                                <GridViewColumn Header="命令预览" Width="520" DisplayMemberBinding="{Binding Command}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>

                <Border Grid.Row="2"
                        Margin="0,18,0,0"
                        Background="White"
                        BorderBrush="#DDE3EA"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10">
                    <ListBox ItemsSource="{Binding ExecutionLogs}"
                             BorderThickness="0"
                             FontFamily="Consolas"
                             FontSize="12" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
