<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>RobotNet.Windows.Wpf</AssemblyName>
    <RootNamespace>RobotNet.Windows.Wpf</RootNamespace>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets/RobotNet.ico</ApplicationIcon>
    <Version>0.7.3</Version>
    <AssemblyVersion>0.7.3.0</AssemblyVersion>
    <FileVersion>0.7.3.0</FileVersion>
    <InformationalVersion>0.7.3-auto-pairing</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets/RobotNet.ico" />
    <Resource Include="../assets/RobotNet.png" Link="Assets/RobotNet.png" />
  </ItemGroup>

</Project>
